#include <iostream>
#include <string>
using namespace std;

struct Node {
    char data;
    Node* next;
    Node(char c) {
        data = c;
        next = NULL;
    }
};

struct Stack {
    Node* topNode;
    Stack() {
        topNode = NULL;
    }
    bool isEmpty() {
        return topNode == NULL;
    }
    void push(char c) {
        Node* n = new Node(c);
        n->next = topNode;
        topNode = n;
    }
    void pop() {
        if (isEmpty())
            return;
        Node* temp = topNode;
        topNode = topNode->next;
        delete temp;
    }
    char top() {
        return topNode->data;
    }
    ~Stack() {
        while (!isEmpty())
            pop();
    }
};

int precedence(char op) {
    if (op == '^')
        return 3;
    if (op == '*' || op == '/')
        return 2;
    if (op == '+' || op == '-')
        return 1;
    return 0;
}

bool isOperand(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
}

string infixToPostfix(string infix) {
    Stack s;
    string postfix = "";
    for (int i = 0; i < (int)infix.length(); i++) {
        char c = infix[i];
        if (c == ' ')
            continue;
        if (isOperand(c)) {
            postfix += c;
        } else if (c == '(') {
            s.push(c);
        } else if (c == ')') {
            while (!s.isEmpty() && s.top() != '(') {
                postfix += s.top();
                s.pop();
            }
            if (!s.isEmpty())
                s.pop();
        } else {
            while (!s.isEmpty() && s.top() != '(' &&
                   (precedence(s.top()) > precedence(c) ||
                   (precedence(s.top()) == precedence(c) && c != '^'))) {
                postfix += s.top();
                s.pop();
            }
            s.push(c);
        }
    }
    while (!s.isEmpty()) {
        postfix += s.top();
        s.pop();
    }
    return postfix;
}

int main() {
    string tests[] = {"A+B*C", "(A+B)*C", "A+B*C-D/E", "A^B^C", "((A+B)*(C-D))/E", "a*(b+c)/d-e", "A-B-C", "2+3*4"};
    for (int i = 0; i < 8; i++) {
        cout << "Infix   : " << tests[i] << endl;
        cout << "Postfix : " << infixToPostfix(tests[i]) << endl << endl;
    }
    return 0;
}
