#include <iostream>
using namespace std;

struct BST {
    int data;
    BST *left;
    BST *right;
    BST(int d) : data(d), left(NULL), right(NULL) {}
};

BST *root = NULL;

void insert(int value) {
    BST *curr = new BST(value);
    if (root == NULL) {
        root = curr;
        return;
    }
    BST *p = root, *q = NULL;
    while (p != NULL) {
        q = p;
        if (value > p->data)
            p = p->right;
        else
            p = p->left;
    }
    if (value > q->data)
        q->right = curr;
    else
        q->left = curr;
}

// Prints every leaf (left to right) and returns how many there are
int printAndCountLeaves(BST *node) {
    if (node == NULL)
        return 0;
    if (node->left == NULL && node->right == NULL) {
        cout << node->data << " ";
        return 1;
    }
    return printAndCountLeaves(node->left) + printAndCountLeaves(node->right);
}

int main() {
    int values[] = {50, 30, 70, 20, 40, 60, 80, 35, 65};
    int n = sizeof(values) / sizeof(values[0]);

    for (int i = 0; i < n; i++)
        insert(values[i]);

    cout << "Leaf nodes: ";
    int count = printAndCountLeaves(root);
    cout << "\nTotal number of leaf nodes: " << count << endl;

    return 0;
}
