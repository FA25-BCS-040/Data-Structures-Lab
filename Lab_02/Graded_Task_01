#include <iostream>   // for cout and cin
using namespace std;  // so i dont need to type std:: again and again

struct Nodetype       // this is the node of the linked list, same name as in the manual
{
    int data;         // the value stored inside the node
    Nodetype *next;   // pointer that holds address of the next node
};

Nodetype *first = NULL;   // points to the first node, NULL because list is empty at start
Nodetype *last = NULL;    // points to the last node, also NULL in the begining

void insert_end()         // inserts a new node at the end (activity 1 from the manual)
{
    Nodetype *p;          // temp pointer to hold the new node
    p = new Nodetype;     // new gives us memory at runtime for the node
    cout << "Enter the data in node: ";   // ask the user for value
    cin >> p->data;       // store the value in the node's data
    p->next = NULL;       // new node will be last so its next must be NULL, otherwise it has garbage
    if (first == NULL)    // checking if list is empty
    {
        first = last = p; // only one node so first and last both point to it
    }
    else
    {
        last->next = p;   // old last node now links to the new one
        last = p;         // last pointer moves to the new node
    }
}

void insert_start()       // inserts a new node at the start (activity 2)
{
    Nodetype *p;          // temp pointer for new node
    p = new Nodetype;     // allocate memory for it
    cout << "Enter the data in node: ";   // ask for value
    cin >> p->data;       // read value into node
    p->next = NULL;       // set next to NULL first to be safe
    if (first == NULL)    // empty list check
    {
        first = last = p; // first and last are the same node
    }
    else
    {
        p->next = first;  // new node points to the old first node
        first = p;        // first now points to the new node
    }
}

void display()            // normal display from first to last
{
    Nodetype *p = first;  // start from the first node
    if (p == NULL)        // nothing in the list
    {
        cout << "Linked List is empty" << endl;   // tell the user
        return;           // leave the function
    }
    while (p != NULL)     // keep going till we fall off the end
    {
        cout << p->data << " ";   // print current node value
        p = p->next;      // move to next node
    }
    cout << endl;         // new line for neat output
}

