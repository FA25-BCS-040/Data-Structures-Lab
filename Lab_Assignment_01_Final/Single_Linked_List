#include <iostream>
#include <string>
using namespace std;

template <typename T>
struct Node {
    T     data;
    Node* next;
    Node(T d) : data(d), next(nullptr) {}
};

// ----------------------------- helper utilities ----------------------------
template <typename T>
Node<T>* pushBack(Node<T>*& head, T value) {          // used only to build test data
    Node<T>* n = new Node<T>(value);
    if (!head) { head = n; return n; }
    Node<T>* t = head;
    while (t->next) t = t->next;
    t->next = n;
    return n;
}

template <typename T>
void printList(const string& label, Node<T>* head) {
    cout << label;
    if (!head) cout << "(empty)";
    for (Node<T>* c = head; c; c = c->next) {
        cout << c->data;
        if (c->next) cout << " -> ";
    }
    cout << endl;
}

template <typename T>
void freeList(Node<T>*& head) {
    while (head) { Node<T>* t = head; head = head->next; delete t; }
}

template <typename T>
int countNodes(Node<T>* head) {
    int n = 0;
    for (; head; head = head->next) n++;
    return n;
}

// ----------------------------------------------------------------------------
// Task 1: Display list in reverse order WITHOUT modifying it (recursion)
// ----------------------------------------------------------------------------
template <typename T>
void printReverseRec(Node<T>* node) {
    if (!node) return;
    printReverseRec(node->next);          // go to the end first
    cout << node->data << " ";            // print while unwinding
}
template <typename T>
void displayReverse(Node<T>* head) {
    printReverseRec(head);
    cout << endl;
}

// ----------------------------------------------------------------------------
// Task 2: Reverse the list itself by changing links only (3-pointer method)
// ----------------------------------------------------------------------------
template <typename T>
Node<T>* reverseList(Node<T>* head) {
    Node<T>* prev = nullptr;
    Node<T>* curr = head;
    while (curr) {
        Node<T>* nxt = curr->next;        // remember rest of list
        curr->next = prev;                // flip the link
        prev = curr;
        curr = nxt;
    }
    return prev;                          // old tail = new head
}

// ----------------------------------------------------------------------------
// Task 3 & 8: Remove duplicates from an UNSORTED list (keep first occurrence).
//   For each node, a runner scans the remainder and unlinks equal nodes.
//   No hash set / extra container is used  ->  O(n^2) time, O(1) space.
// ----------------------------------------------------------------------------
template <typename T>
void removeDuplicates(Node<T>* head) {
    for (Node<T>* cur = head; cur; cur = cur->next) {
        Node<T>* runner = cur;
        while (runner->next) {
            if (runner->next->data == cur->data) {
                Node<T>* dup = runner->next;
                runner->next = dup->next;
                delete dup;
            } else {
                runner = runner->next;
            }
        }
    }
}

// ----------------------------------------------------------------------------
// Task 4: Detect a loop (Floyd's tortoise & hare)
// ----------------------------------------------------------------------------
template <typename T>
bool hasLoop(Node<T>* head) {
    Node<T>* slow = head;
    Node<T>* fast = head;
    while (fast && fast->next) {
        slow = slow->next;                // 1 step
        fast = fast->next->next;          // 2 steps
        if (slow == fast) return true;    // they can only meet inside a cycle
    }
    return false;                         // fast reached NULL -> no cycle
}

// ----------------------------------------------------------------------------
// Task 5: Middle node (for an even count return the LEFT of the two middles)
// ----------------------------------------------------------------------------
template <typename T>
Node<T>* findMiddle(Node<T>* head) {
    if (!head) return nullptr;
    Node<T>* slow = head;
    Node<T>* fast = head;
    while (fast->next && fast->next->next) {   // stops one step early for even n
        slow = slow->next;
        fast = fast->next->next;
    }
    return slow;
}

// ----------------------------------------------------------------------------
// Task 6: Split into an EVEN-valued list and an ODD-valued list.
//   Existing nodes are re-linked (relative order preserved).
// ----------------------------------------------------------------------------
void splitEvenOdd(Node<int>* head, Node<int>*& evenHead, Node<int>*& oddHead) {
    evenHead = oddHead = nullptr;
    Node<int>* evenTail = nullptr;
    Node<int>* oddTail  = nullptr;
    while (head) {
        Node<int>* nxt = head->next;
        head->next = nullptr;
        if (head->data % 2 == 0) {
            if (!evenHead) evenHead = head; else evenTail->next = head;
            evenTail = head;
        } else {
            if (!oddHead) oddHead = head; else oddTail->next = head;
            oddTail = head;
        }
        head = nxt;
    }
}

// ----------------------------------------------------------------------------
// Task 7: Reverse the first half and the second half separately.
//   1..8  ->  4 3 2 1 8 7 6 5.   (n odd: first half = n/2 nodes, rest = second)
// ----------------------------------------------------------------------------
// reverses the first k nodes; 'rest' receives the node after them
template <typename T>
Node<T>* reverseFirstK(Node<T>* head, int k, Node<T>*& rest) {
    Node<T>* prev = nullptr;
    Node<T>* curr = head;
    while (k-- > 0 && curr) {
        Node<T>* nxt = curr->next;
        curr->next = prev;
        prev = curr;
        curr = nxt;
    }
    rest = curr;
    return prev;
}
template <typename T>
Node<T>* reverseHalves(Node<T>* head) {
    int n = countNodes(head);
    if (n < 2) return head;
    int half = n / 2;

    Node<T>* secondStart = nullptr;
    Node<T>* firstRev  = reverseFirstK(head, half, secondStart);   // old head is now tail of 1st half
    Node<T>* dummy     = nullptr;
    Node<T>* secondRev = reverseFirstK(secondStart, n - half, dummy);

    head->next = secondRev;               // 'head' (old first node) is the tail of the first half
    return firstRev;
}

// ----------------------------------------------------------------------------
// Task 9: Delete ALL occurrences of a key (head / middle / tail / repeated)
// ----------------------------------------------------------------------------
template <typename T>
Node<T>* deleteAllOccurrences(Node<T>* head, T key) {
    while (head && head->data == key) {            // leading matches
        Node<T>* t = head;
        head = head->next;
        delete t;
    }
    Node<T>* cur = head;
    while (cur && cur->next) {                     // middle / end matches
        if (cur->next->data == key) {
            Node<T>* t = cur->next;
            cur->next = t->next;
            delete t;
        } else {
            cur = cur->next;
        }
    }
    return head;
}

// ----------------------------------------------------------------------------
// Task 10: Swap every two consecutive nodes by re-linking (1 2 3 4 -> 2 1 4 3)
// ----------------------------------------------------------------------------
template <typename T>
Node<T>* swapPairs(Node<T>* head) {
    if (!head || !head->next) return head;
    Node<T>* newHead = head->next;
    Node<T>* prevTail = nullptr;
    Node<T>* curr = head;
    while (curr && curr->next) {
        Node<T>* second = curr->next;
        Node<T>* nextPair = second->next;
        second->next = curr;                       // swap the pair
        curr->next = nextPair;
        if (prevTail) prevTail->next = second;     // connect with previous pair
        prevTail = curr;
        curr = nextPair;
    }
    return newHead;
}

