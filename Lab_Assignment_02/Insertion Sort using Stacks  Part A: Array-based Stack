#include <iostream>

using namespace std;

class ArrayStack {
private:
    int* arr;
    int topIndex;
    int capacity;

public:
    ArrayStack(int cap = 100) {
        capacity = cap;
        arr = new int[capacity];
        topIndex = -1;
    }

    ~ArrayStack() {
        delete[] arr;
    }

    bool isEmpty() const {
        return topIndex == -1;
    }

    bool isFull() const {
        return topIndex == capacity - 1;
    }

    void push(int val) {
        if (isFull()) {
            cout << "Stack Overflow!" << endl;
            return;
        }
        arr[++topIndex] = val;
    }

    int pop() {
        if (isEmpty()) {
            cout << "Stack Underflow!" << endl;
            return -1;
        }
        return arr[topIndex--];
    }

    int peek() const {
        if (isEmpty()) {
            return -1;
        }
        return arr[topIndex];
    }

    void display() {
        if (isEmpty()) {
            cout << "Stack Empty!" << endl;
            return;
        }
        for (int i = topIndex; i >= 0; i--) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }
};

void insertionSortArrayStack(ArrayStack& inputStack, int n) {
    ArrayStack tempStack(n);

    while (!inputStack.isEmpty()) {
        int tmp = inputStack.pop();

        while (!tempStack.isEmpty() && tempStack.peek() > tmp) {
            inputStack.push(tempStack.pop());
        }
        tempStack.push(tmp);
    }

    while (!tempStack.isEmpty()) {
        inputStack.push(tempStack.pop());
    }
}

int main() {
    ArrayStack s(10);

    s.push(34);
    s.push(3);
    s.push(31);
    s.push(98);
    s.push(92);
    s.push(23);

    cout << "Original Stack (Top to Bottom): ";
    s.display();

    insertionSortArrayStack(s, 10);

    cout << "Sorted Stack (Top to Bottom - Ascending): ";
    s.display();

    return 0;
}
