#include <iostream>

using namespace std;

class ArrayQueue {
private:
    int* arr;
    int frontIndex;
    int rearIndex;
    int count;
    int capacity;

public:
    ArrayQueue(int cap = 100) {
        capacity = cap;
        arr = new int[capacity];
        frontIndex = 0;
        rearIndex = -1;
        count = 0;
    }

    ~ArrayQueue() {
        delete[] arr;
    }

    bool isEmpty() const {
        return count == 0;
    }

    bool isFull() const {
        return count == capacity;
    }

    void enqueue(int val) {
        if (isFull()) {
            cout << "Queue Overflow!" << endl;
            return;
        }
        rearIndex = (rearIndex + 1) % capacity;
        arr[rearIndex] = val;
        count++;
    }

    int dequeue() {
        if (isEmpty()) {
            cout << "Queue Underflow!" << endl;
            return -1;
        }
        int val = arr[frontIndex];
        frontIndex = (frontIndex + 1) % capacity;
        count--;
        return val;
    }

    int size() const {
        return count;
    }

    void display() {
        if (isEmpty()) {
            cout << "Queue Empty!" << endl;
            return;
        }
        int idx = frontIndex;
        for (int i = 0; i < count; i++) {
            cout << arr[idx] << " ";
            idx = (idx + 1) % capacity;
        }
        cout << endl;
    }
};

void selectionSortArrayQueue(ArrayQueue& q) {
    int n = q.size();
    for (int i = 0; i < n; i++) {
        int minVal = q.dequeue();
        for (int j = 1; j < n - i; j++) {
            int curr = q.dequeue();
            if (curr < minVal) {
                q.enqueue(minVal);
                minVal = curr;
            } else {
                q.enqueue(curr);
            }
        }
        q.enqueue(minVal);
    }
    for (int i = 0; i < n; i++) {
        q.enqueue(q.dequeue());
    }
}

int main() {
    ArrayQueue q(10);

    q.enqueue(29);
    q.enqueue(10);
    q.enqueue(14);
    q.enqueue(37);
    q.enqueue(13);

    cout << "Original Queue: ";
    q.display();

    selectionSortArrayQueue(q);

    cout << "Sorted Queue: ";
    q.display();

    return 0;
}
